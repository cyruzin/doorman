generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  DOORMAN
}

enum MezaninoRoom {
  GAME_ROOM
  GYM
  KIDS_SPACE
}

enum SchedulingRoom {
  PARTY_HALL
  CINEMA
  GRILL
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(DOORMAN)
  // The seeded first admin — cannot be deleted or demoted, to avoid locking everyone out.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  cpf       String?
  email     String?
  unit      String
  // Soft-deleted instead of removed, so old tenants stay searchable.
  active    Boolean   @default(true)
  phones    Phone[]
  vehicles  Vehicle[]
  // The unit's owner, when this tenant is renting from someone (locador).
  ownerId   String?
  owner     Owner?    @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([unit])
  @@index([ownerId])
}

model Owner {
  id        String    @id @default(cuid())
  name      String
  cpf       String?
  email     String?
  unit      String
  active    Boolean   @default(true)
  phones    Phone[]
  vehicles  Vehicle[]
  // Tenants currently renting from this owner (locatários).
  tenants   Tenant[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([unit])
}

// A resident can have more than one phone — one row per number, linked to
// whichever kind of resident it belongs to (exactly one of tenantId/ownerId is set).
model Phone {
  id         String  @id @default(cuid())
  number     String
  isWhatsapp Boolean @default(false)
  tenantId   String?
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      Owner?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerId])
}

// One row per key checkout of a mezanino room — tracks who's using it and
// when they returned the key. residentName is a snapshot at entry time, so
// history stays readable even if the resident record later changes.
model MezaninoEntry {
  id           String       @id @default(cuid())
  room         MezaninoRoom
  unit         String
  residentName String
  entryAt      DateTime     @default(now())
  exitAt       DateTime?

  @@index([room, entryAt])
  @@index([room, exitAt])
}

// One row per reserved event in a shared space (salão de festas, cinema,
// grill) — tracks who booked it, when, and whether it already happened.
// requesterName is a snapshot at booking time, same rationale as
// MezaninoEntry.residentName. "Excluir" in the UI is a soft cancel
// (cancelledAt), not a hard delete — the paid rooms' control report needs
// cancelled bookings to still show up in history.
model SchedulingEntry {
  id                   String         @id @default(cuid())
  room                 SchedulingRoom
  unit                 String
  requesterName        String
  eventAt              DateTime
  allowMultipleSameDay Boolean        @default(false)
  notes                String?
  finishedAt           DateTime?
  finishedByUsername   String?
  cancelledAt          DateTime?
  cancelledByUsername  String?
  createdAt            DateTime       @default(now())

  @@index([room, eventAt])
}

// A free-text handover note between porteiros ("livro de plantão") — not tied
// to login/logout, just a message any porteiro leaves for whoever's next.
// isAutomatic marks a future system-generated entry (nothing creates one yet)
// so the delete rule can already tell it apart from a manually written one.
model Notice {
  id             String   @id @default(cuid())
  message        String
  authorUsername String
  // Surfaces this note in the last-5 list on the home dashboard, as a
  // heads-up for the next porteiro coming on shift.
  showOnHome     Boolean  @default(false)
  isAutomatic    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// A resident can have more than one vehicle — same shape as Phone.
model Vehicle {
  id       String  @id @default(cuid())
  plate    String?
  model    String?
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId  String?
  owner    Owner?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerId])
}
