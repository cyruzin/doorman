generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  DOORMAN
}

enum MezaninoRoom {
  GAME_ROOM
  GYM
  KIDS_SPACE
}

enum SchedulingRoom {
  PARTY_HALL
  CINEMA
  GRILL
}

model User {
  id           String   @id @default(cuid())
  // The person's real name — shown throughout the UI (nav chip, audit trails
  // like "finalizado por"). username is only the login handle.
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(DOORMAN)
  // The seeded first admin — cannot be deleted or demoted, to avoid locking everyone out.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// One row per (role, resource, action) granted — presence means allowed.
// Replaces the old hardcoded matrix in src/lib/permissions.ts so an admin
// can tune it from the Usuários > Permissões screen without a code change.
model RolePermission {
  id       String @id @default(cuid())
  role     Role
  resource String
  action   String

  @@unique([role, resource, action])
}

// A person currently living in a unit — can be more than one per unit, and
// can also be the unit's owner (isOwner). When isOwner is true, ownerId links
// to the canonical Owner record instead of duplicating their name/cpf/email —
// the API derives those three fields from the linked Owner on write.
model Resident {
  id        String    @id @default(cuid())
  name      String
  cpf       String?
  email     String?
  unit      String
  // Soft-deleted instead of removed, so old residents stay searchable.
  active    Boolean   @default(true)
  isOwner   Boolean   @default(false)
  ownerId   String?
  owner     Owner?    @relation(fields: [ownerId], references: [id])
  phones    Phone[]
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([unit])
  @@index([ownerId])
}

model Owner {
  id        String      @id @default(cuid())
  name      String
  // The dedup identifier — required going forward (enforced in the Zod
  // schema, not here: a hard NOT NULL would break legacy rows without one).
  // Unique constraint allows multiple NULLs (SQL semantics) but rejects a
  // second owner with the same CPF.
  cpf       String?     @unique
  email     String?
  active    Boolean     @default(true)
  phones    Phone[]
  vehicles  Vehicle[]
  units     OwnerUnit[]
  // Residents who are also this owner (isOwner: true, linked via ownerId).
  residents Resident[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([name])
}

// One row per unit an owner holds — lets an owner have multiple apartments.
// "One owner per unit" is enforced in the API (findClaimedUnits), scoped to
// active owners, not as a hard unique constraint here — a deactivated
// owner's old units must stay claimable by whoever takes over, the same way
// every other soft-deleted record in this app keeps its history without
// blocking new writes.
model OwnerUnit {
  id        String   @id @default(cuid())
  ownerId   String
  unit      String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([unit])
  @@index([ownerId])
}

// A resident can have more than one phone — one row per number, linked to
// whichever kind of resident it belongs to (exactly one of residentId/ownerId is set).
model Phone {
  id         String    @id @default(cuid())
  number     String
  isWhatsapp Boolean   @default(false)
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([ownerId])
}

// One row per key checkout of a mezanino room — tracks who's using it and
// when they returned the key. residentName is a snapshot at entry time, so
// history stays readable even if the resident record later changes.
model MezaninoEntry {
  id           String       @id @default(cuid())
  room         MezaninoRoom
  unit         String
  residentName String
  entryAt      DateTime     @default(now())
  exitAt       DateTime?

  @@index([room, entryAt])
  @@index([room, exitAt])
}

// One row per reserved event in a shared space (salão de festas, cinema,
// grill) — tracks who booked it, when, and whether it already happened.
// requesterName is a snapshot at booking time, same rationale as
// MezaninoEntry.residentName. "Excluir" in the UI is a soft cancel
// (cancelledAt), not a hard delete — the paid rooms' control report needs
// cancelled bookings to still show up in history.
model SchedulingEntry {
  id                   String         @id @default(cuid())
  room                 SchedulingRoom
  unit                 String
  requesterName        String
  eventAt              DateTime
  allowMultipleSameDay Boolean        @default(false)
  notes                String?
  finishedAt           DateTime?
  finishedByUsername   String?
  cancelledAt          DateTime?
  cancelledByUsername  String?
  createdAt            DateTime       @default(now())

  @@index([room, eventAt])
}

// A free-text handover note between porteiros ("livro de plantão") — not tied
// to login/logout, just a message any porteiro leaves for whoever's next.
// isAutomatic marks a future system-generated entry (nothing creates one yet)
// so the delete rule can already tell it apart from a manually written one.
model Notice {
  id             String   @id @default(cuid())
  message        String
  authorUsername String
  // Surfaces this note in the last-5 list on the home dashboard, as a
  // heads-up for the next porteiro coming on shift.
  showOnHome     Boolean  @default(false)
  isAutomatic    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// A resident can have more than one vehicle — same shape as Phone.
model Vehicle {
  id         String    @id @default(cuid())
  plate      String?
  model      String?
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([residentId])
  @@index([ownerId])
}
